DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,192.168.1.50
DATABASE_URL=postgres://stock_user:stock_password@localhost:5432/stockflow
TIME_ZONE=Africa/Nairobi
CURRENCY=KES
# Public address of the app, used in links sent by SMS (driver tracking). Blank = the address the request came in on.
PUBLIC_APP_URL=https://stockflow-zz3q.onrender.com/

# Email: forgot-password codes are sent from this Gmail account.
# Google Account → Security → 2-Step Verification ON → App passwords → create one for "StockFlow" and paste it below.
# While EMAIL_HOST_PASSWORD is empty, emails are printed in the terminal instead of being sent.
EMAIL_HOST_USER=vinwonder05@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=StockFlow <vinwonder05@gmail.com>
# Require a 6-digit email code to confirm the email during sign-up (expires after 15 minutes).
SIGNUP_EMAIL_CODE=True
# On Render (free plan blocks SMTP) put a Brevo API key here instead; it takes priority over Gmail SMTP.
BREVO_API_KEY=

# M-Pesa (Safaricom Daraja, https://developer.safaricom.co.ke). console = test mode, prompts are marked paid automatically.
MPESA_BACKEND=console
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# CustomerPayBillOnline (paybill) or CustomerBuyGoodsOnline (till; then put the till number in MPESA_PARTY_B)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=
# Blank = https://<this server>/api/mpesa/callback/?token=<MPESA_CALLBACK_TOKEN>. Must be public HTTPS.
MPESA_CALLBACK_URL=
MPESA_CALLBACK_TOKEN=make-another-long-random-string

# Google Maps for store positions and live transfer tracking. Without a key the app shows OpenStreetMap instead.
GOOGLE_MAPS_API_KEY=

# Messaging: console prints messages in the terminal (free, for development)
SMS_BACKEND=console
WHATSAPP_BACKEND=console
BUSINESS_SMS_NUMBER=
BUSINESS_WHATSAPP_NUMBER=
INBOUND_TOKEN=make-a-long-random-string

# Africa's Talking (SMS) — https://account.africastalking.com
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# Twilio (WhatsApp) — https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
